#!/usr/bin/env python3
"""civ - talk to the running Civ IV game through the CIVAI mod mailbox.

  civ ping                 is the game there, whose turn is it
  civ status               compact digest of Claude's empire
  civ map [X Y [R]]        schematic map (PNG); with X Y: zoom on a square of radius R (default 6)
  civ tile X Y             one tile: terrain, resource, owner, yields, units (foreign ones with
                           the health, strength and promotions a human sees on hover)
  civ odds X Y [unit id]   attack odds against the best defender on X Y (what a human sees
                           hovering the attack): one unit, or every unit of ours in reach
  civ city <name>          a city: full detail if mine, what I can see if not
  civ unit <id>            one of my units
  civ player <name|civ|id> a player I have met
  civ move <id> X Y        walk a unit to X Y (several turns if needed); the unit becomes Claude's
  civ actions <unit id>    what the unit can do right now (the game's own buttons)
  civ do <unit id> <action> [X Y | unit id] [--queue]   (LEAD <unit id>: a Great General joins that unit)
                           do one: FORTIFY, SENTRY, FOUND, BUILD_FARM, BUILD_ROAD, PILLAGE,
                           PROMOTE_COMBAT1, UPGRADE_..., AUTO_BUILD, AUTO_EXPLORE, ...;
                           MOVE_TO / ROUTE_TO take X Y; the unit stays Claude's (AUTO_ hands
                           it to the game's automation); a finished job wakes Claude (unit_done)
  civ offer <player> [--give ITEM...] [--get ITEM...]
                           propose a deal; items: tech:<name>, gold:<n>, open_borders,
                           defensive_pact, peace, war:<player>, peace_with:<player> (make peace
                           with a third leader). An AI answers at once (game's refusal rules
                           + value); the human sees it on screen and types
                           !accept N / !decline N in chat (deal_done / deal_declined events)
  civ give <player> ITEM...  a gift (no answer needed), e.g. civ give India tech:Alphabet
  civ offers               open offers waiting for an answer
  civ proposals            what other leaders proposed, demanded or asked of us (they wait for
                           our answer until the end of the next turn; no answer = no)
  civ answer N yes|no      answer proposal N: a deal is made by the game's own rules; a refused
                           demand may mean war; requests (convert, switch civic, join a war,
                           stop trading) take effect on yes
  civ tradeable <player>   what each side can trade right now (the game's trade screen)
  civ relations            the Foreign Advisor view of the leaders we've met: wars, treaties, vassals,
                           how each AI feels about the others, its worst enemy, state religions
  civ victory              the Victory screen: scores of the leaders we've met, our progress toward each
                           way to win (domination, culture, conquest, diplomacy, space, time)
  civ rules <name>         the game's rules for a tech, unit, building, civic, worker build
                           or resource (cost, requirements, what it unlocks, strategy text),
                           or a Civilopedia article on how the game works (war, borders,
                           combat, happiness...); `civ rules concepts` lists the articles
  civ rules path <tech>    the techs still needed to reach <tech>, in order, with turns
  civ religion [name|none]  state religion: options, or adopt one (normal anarchy)
  civ civics [civic]...    civics: current and possible, or switch to the named civics
                           (the built-in AI can't change religion or civics for us: the
                           bridge undoes its changes, event ai_change_undone)
  civ war <player> [--check]
                           declare war (only Claude declares wars for its civ); --check only
                           shows what it would do: deals that end, our units pushed out of
                           their land
  civ ratify <N>           keep deal #N that the built-in AI agreed to for us (event native_deal)
  civ reject <N>           undo deal #N: ongoing parts end without a grudge, techs and gold go back
                           (peace and vassal treaties can't be undone); `civ offers` lists them
  civ deals                our ongoing deals (open borders, pacts, resources...) and when each can be cancelled
  civ cancel <deal#|player>  end an ongoing deal, like the diplomacy screen's "cancel" (the other side remembers)
  civ budget [research N gold N culture N espionage N | auto]
                           the commerce split: show it, or set it (steps of 10, sum 100; gold takes
                           what's left); it stays until you change it
  civ raze <city>          burn a city we just captured (this turn or last); otherwise captured cities are kept
  civ around X Y           one place and its 8 neighbours: ground (HILL/flat, forest, river, road),
                           owner, city, resource, units; every line with its coordinates
  civ where X Y [X Y...]   a place in words for leaders who see no coordinates: "the hill, jungle tile
                           2 tiles south-west of Uppsala = 1 east and 2 north of Turfan"
  civ card <city>          battle card for attacking a city: the ground under it, the tiles around it
                           ranked for attackers, the approach from our nearest city, foreign units near
  civ area X Y [R]         text map of the region around X Y (radius R, default 6) with cities,
                           resources, foreign units, borders, and the best city sites there
  civ research [tech] [--queue]
                           no tech: what we research, the queue, what we can research (turns);
                           tech: research it now (missing prerequisites are queued first);
                           --queue: add it after the current queue
  civ build <city> auto    hand a city's builds to the game's automation (until you civ build there)
  civ build <city> <item> [--queue|--first|--check]
                           what a city builds (unit, building, project, or Wealth/Research);
                           replaces the current item unless --queue (at the end) / --first;
                           --check only tells whether it is possible. The built-in AI then
                           leaves that city's queue alone until it runs empty
  civ hurry <city> [whip|buy]
                           the game's Hurry button: without whip/buy only shows the price
                           (population / gold / unhappiness turns) for the current item
  civ claim <id>           take a unit from the built-in AI: it waits for Claude's orders
  civ release <id|all>     give unit(s) back to the built-in AI
  civ py "<code>"          DIRECTOR ONLY (needs CIV_DEV=1): run Python inside the game (sees everything, logged to exec.log);
                           an expression returns its value, statements return `result`
  civ ready                Claude is done with this turn: the player may end it
  civ gate [on|off]        turn gate: the player cannot end the turn until `civ ready`
  civ gate auto on|off [N] auto-ready quiet turns; wake Claude ("claude_wake") only when
                           something happened, an enemy is near, or every N turns (default 5)
  civ hold                 take "ready" back: the player must wait for the next `civ ready`
  civ say "<text>"         chat line to the player in the game, from Claude's leader
  civ say --popup "<text>" the same as a popup window
  civ chat [N]             last N chat messages both ways (default 20); works without the game
  civ director "<text>"    a note to the CIVAI director (not the game): a broken or missing tool,
                           something that looks wrong; answers come in director_notes.md.
                           Without text: what was sent
  civ think "<text>"       one line of Claude's reasoning for the video (thoughts.log)
  civ events [N]           last N things that happened (default 30); works without the game
  civ raw <cmd> [json]     send any bridge command, print the JSON reply

Everything is limited to what Claude's civilization knows (fog of war).
CIV_PLAYER=N makes the commands act for AI civ N (several agents in one game); humans are refused.
The game answers only while a game is loaded; commands wait up to 2 min.
"""
import json
import os
import sys
import subprocess
import time
import uuid

BRIDGE = os.path.expanduser(
    "~/Library/Application Support/CrossOver/Bottles/%s/drive_c/claude_bridge" % os.environ.get("CIV_BOTTLE", "civ4"))
IN_DIR = os.path.join(BRIDGE, "in")
OUT_DIR = os.path.join(BRIDGE, "out")
TIMEOUT = float(os.environ.get("CIV_TIMEOUT", "120"))
MOVE = 60  # Civ IV counts movement in 1/60ths


class BridgeError(Exception):
    pass


def call(cmd, args=None, timeout=TIMEOUT):
    os.makedirs(IN_DIR, exist_ok=True)
    os.makedirs(OUT_DIR, exist_ok=True)
    rid = "%d-%s" % (time.time() * 1000, uuid.uuid4().hex[:6])
    tmp = os.path.join(IN_DIR, rid + ".tmp")
    with open(tmp, "w") as f:
        req = {"id": rid, "cmd": cmd, "args": args or {}}
        if os.environ.get("CIV_DEV") == "1" and cmd == "exec":
            req["dev"] = True    # the director's mark; game sessions must never set CIV_DEV
        if os.environ.get("CIV_PLAYER"):
            req["player"] = int(os.environ["CIV_PLAYER"])   # act as this AI civ (multi-agent games)
        json.dump(req, f)
    os.rename(tmp, os.path.join(IN_DIR, rid + ".json"))
    reply_path = os.path.join(OUT_DIR, rid + ".json")
    deadline = time.time() + timeout
    hinted = False
    while time.time() < deadline:
        if not hinted and time.time() > deadline - timeout + 3:
            # Civ IV only ticks while its window has focus
            print("(waiting for the game - it answers only while a game is loaded)", file=sys.stderr)
            hinted = True
        if os.path.exists(reply_path):
            with open(reply_path) as f:
                reply = json.load(f)
            os.remove(reply_path)
            if not reply.get("ok"):
                raise BridgeError(reply.get("error", "unknown error").strip())
            return reply["result"]
        time.sleep(0.05)
    # the game never picked it up: withdraw the request so it doesn't fire later
    try:
        os.remove(os.path.join(IN_DIR, rid + ".json"))
    except FileNotFoundError:
        pass
    raise BridgeError("game did not answer in %.0fs - is Civ IV running with the CIVAI mod?" % timeout)


def short(t):
    if not t:
        return "-"
    if t in ("ROUTE_TO",):   # an action name, not a route type
        return t
    for p in ("UNIT_", "TECH_", "LEADER_", "ERA_", "RELIGION_", "ATTITUDE_", "BONUS_", "CIVIC_",
              "BUILDING_", "FEATURE_", "TERRAIN_", "IMPROVEMENT_", "ROUTE_", "SPECIALIST_", "PROJECT_",
              "PROCESS_", "CULTURELEVEL_", "GOODY_", "PROMOTION_"):
        if t.startswith(p):
            return t[len(p):].replace("_", " ").title()
    return t


def year(y):
    return "%d BC" % -y if y < 0 else "%d AD" % y


def land_name(owner, players):
    if owner is None or owner < 0:
        return "on unclaimed land"
    p = players.get(owner)
    return "in %s's land" % (p["name"] if p else "player %d" % owner)


def fmt_status(s):
    me = s["me"]
    players = {p["id"]: p for p in s["players"]}
    mep, emp = players[me], s["my_empire"]
    out = ["Turn %d, %s. I am %s of %s (player %d)." % (
        s["turn"], year(s["year"]), mep["name"], mep["civ"], me)]
    out.append("Gold %d (%+d/turn). Research: %s (%s turns). Era %s. State religion %s." % (
        emp["gold"], emp["gold_per_turn"], short(emp["research"]), emp.get("research_turns", "?"),
        short(mep.get("era")), short(mep.get("state_religion"))))
    f = emp.get("finances")
    if f:
        costs = f["cities"] + f["civics"] + f["units"] + f["unit_supply"] + f["inflation"]
        line = "Money: income %d; costs %d = cities %d, civics %d, units %d, unit supply %d, inflation %d." % (
            f["income"], costs, f["cities"], f["civics"], f["units"], f["unit_supply"], f["inflation"])
        if emp["gold_per_turn"] < 0:
            line += " The treasury runs dry in %d turns; at 0 the game disbands units." % (emp["gold"] // -emp["gold_per_turn"])
        out.append(line)
    out.append("")
    out.append("Cities:")
    for c in emp["cities"]:
        out.append("  %-12s (%d,%d) pop %d%s | builds %s (%dt) | grows %st | happy %d/%d health %d/%d" % (
            c["name"], c["x"], c["y"], c["pop"], " capital" if c["capital"] else "",
            c["building"] or "nothing", c["build_turns"],
            c["food_turns"] if c["food_turns"] >= 0 else "-",
            c["happy"], c["unhappy"], c["health"], c["unhealth"]))
    if not emp["cities"]:
        out.append("  (none)")
    out.append("")
    out.append("Units:")
    for u in sorted(s["my_units"], key=lambda u: (u["x"], u["y"], u["id"])):
        flags = []
        if u["automated"]:
            flags.append("automated")
        if u["fortified"]:
            flags.append("fortified")
        if u["waiting"]:
            flags.append("waiting")
        if u.get("claimed"):
            flags.append("CLAUDE" + (" -> %d,%d" % tuple(u["target"]) if u.get("target") else ", waiting for orders"))
        if u["missions_queued"]:
            flags.append("%d orders queued" % u["missions_queued"])
        if u["damage"]:
            flags.append("damaged %d%%" % u["damage"])
        if u.get("land", me) != me:
            flags.append(land_name(u["land"], players))
        out.append("  #%-5d %-14s (%d,%d) moves %g/%g lvl %d%s" % (
            u["id"], short(u["type"]), u["x"], u["y"], u["moves"] / MOVE, u["max_moves"] / MOVE,
            u["level"], ("  [" + ", ".join(flags) + "]") if flags else ""))
    out.append("")
    out.append("Foreign units I see now:")
    order = {"inside": 0, "near": 1, "elsewhere": 2}
    seen = sorted(s.get("foreign_seen", []), key=lambda g: (not g["war"], order[g["where"]], g["who"], g["x"], g["y"]))
    for g in seen:
        names = {}
        for n in g["units"]:
            names[n] = names.get(n, 0) + 1
        where = "inside my borders" if g["where"] == "inside" else land_name(g["land"], players) + (
            ", near my borders" if g["where"] == "near" else "")
        out.append("  %s%s at (%d,%d) %s: %s" % (
            "[AT WAR] " if g["war"] else "", g["who"], g["x"], g["y"], where,
            ", ".join("%d %s" % (c, n) if c > 1 else n for n, c in names.items())))
    if not seen:
        out.append("  (none)")
    out.append("")
    out.append("Others:")
    known = False
    for p in sorted(players.values(), key=lambda p: p["id"]):
        if p["id"] == me or not p.get("met") or p.get("barbarian"):
            continue
        known = True
        out.append("  %s of %s%s: score %s, era %s, attitude to me %s%s" % (
            p["name"], p["civ"], " [HUMAN]" if p.get("human") else "", p.get("score"),
            short(p.get("era")), short(p.get("their_attitude_to_me")),
            ", AT WAR" if p.get("at_war_with_me") else ""))
    unmet = sum(1 for p in players.values() if not p.get("met") and not p.get("barbarian"))
    if not known:
        out.append("  nobody met yet")
    out.append("  not met: %d civs" % unmet)
    return "\n".join(out)


HERE = os.path.dirname(os.path.realpath(__file__))
OUT = os.path.join(HERE, "out")
EVENTS = os.path.join(BRIDGE, "events.jsonl")
CHAT = os.path.join(BRIDGE, "chat.jsonl")
# video logs: every command and every thought, with wall-clock time, for overlays in the edit
def current_game():
    # games/CURRENT holds the id of the game being played; CIV_GAME overrides it
    try:
        with open(os.path.join(HERE, "games", "CURRENT")) as f:
            name = f.read().strip()
    except FileNotFoundError:
        name = "game"
    return os.environ.get("CIV_GAME", name)


VIDEO_LOG_DIR = os.path.join(HERE, "games", current_game())


FIELD_ORDER = ["id", "name", "type", "civ", "leader", "owner", "human", "x", "y", "pop", "capital",
               "strength", "moves", "max_moves", "moves_per_turn", "damage", "level", "xp", "promotions"]


def fmt_value(v):
    if v is None:
        return "-"
    if isinstance(v, str):
        return short(v)
    if isinstance(v, bool):
        return "yes" if v else "no"
    if isinstance(v, list):
        if v and isinstance(v[0], dict):
            return "; ".join(fmt_inline(x) for x in v)
        return ", ".join(fmt_value(x) for x in v) if v else "-"
    if isinstance(v, dict):
        return fmt_inline(v)
    return str(v)


def fmt_inline(d):
    return " ".join("%s=%s" % (k, fmt_value(v)) for k, v in d.items())


def fmt_record(d, skip=()):
    for k in ("moves", "max_moves"):
        if isinstance(d.get(k), int):
            d[k] = "%g" % (d[k] / MOVE)  # game counts movement in 1/60ths
    rank = {k: i for i, k in enumerate(FIELD_ORDER)}
    out = []
    for k, v in sorted(d.items(), key=lambda kv: (rank.get(kv[0], len(rank)), kv[0])):
        if k in skip:
            continue
        out.append("%-16s %s" % (k + ":", fmt_value(v)))
    return "\n".join(out)


def cmd_map(argv):
    sys.path.insert(0, HERE)
    import render_map
    state = call("map")
    os.makedirs(OUT, exist_ok=True)
    region = None
    if len(argv) >= 2:
        x, y = int(argv[0]), int(argv[1])
        r = int(argv[2]) if len(argv) > 2 else 6
        region = (x - r, y - r, x + r, y + r)
    png = os.path.join(OUT, "map_T%03d.png" % state["turn"])
    render_map.render(state, png, region)
    with open(os.path.join(OUT, "state_T%03d.json" % state["turn"]), "w") as f:
        json.dump(state, f)
    print(png)
    print(png.replace(".png", "_zoom.png"))
    print(render_map.summary_short(state) if hasattr(render_map, "summary_short") else "")


def cmd_city(argv):
    d = call("city", {"name": " ".join(argv)})
    tiles = d.pop("tiles", None)
    d.pop("tile_fields", None)
    print(fmt_record(d))
    if tiles:
        worked = ["(%d,%d) %d/%d/%d" % (t[0], t[1], t[3], t[4], t[5]) for t in tiles if t[2]]
        free = ["(%d,%d) %d/%d/%d" % (t[0], t[1], t[3], t[4], t[5]) for t in tiles if not t[2]]
        print("%-16s %s" % ("worked tiles:", ", ".join(worked) + "   (food/production/commerce)"))
        print("%-16s %s" % ("other tiles:", ", ".join(free)))


def cmd_player(argv):
    d = call("player", {"name": " ".join(argv)})
    print(fmt_record(d, skip=("color",)))


def cmd_events(argv):
    n = int(argv[0]) if argv else 30
    if not os.path.exists(EVENTS):
        print("no events yet")
        return
    sys.path.insert(0, HERE)
    import timeline
    for e in timeline.read(EVENTS, timeline.event_rewind, keep_markers=True)[-n:]:   # not the abandoned turns of a reload
        e.pop("wall", None)
        head = "T%-4d %-8s %s" % (e.pop("turn"), year(e.pop("year")), e.pop("kind"))
        e.pop("time", None)
        print(head + ("  " + fmt_inline(e) if e else ""))


def video_log(name, record):
    os.makedirs(VIDEO_LOG_DIR, exist_ok=True)
    # "by": who ran it (the loop sets CIV_ACTOR=agent for the player; anything else is the director or a person)
    record = dict(record, wall=time.strftime("%Y-%m-%d %H:%M:%S"), by=os.environ.get("CIV_ACTOR", "director"))
    with open(os.path.join(VIDEO_LOG_DIR, name), "a") as f:
        f.write(json.dumps(record, ensure_ascii=False) + "\n")


def main(argv):
    if argv and argv[0] not in ("-h", "--help", "help", "think", "events", "chat", "director"):
        video_log("commands.jsonl", {"cmd": " ".join(argv)[:500]})
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    try:
        if cmd == "ping":
            t0 = time.time()
            r = call("ping")
            ms = (time.time() - t0) * 1000
            if not r["game_ready"]:
                print("bridge alive (%.0f ms), no game in progress" % ms)
            else:
                print("bridge v%s alive (%.0f ms). Turn %d, %s. Claude = player %d. Turn active: %s" % (
                    r.get("bridge_version", 1), ms, r["turn"], year(r["year"]), r["claude_player"],
                    r["turn_active_players"]))
        elif cmd == "status":
            print(fmt_status(call("status")))
        elif cmd == "map":
            cmd_map(argv[1:])
        elif cmd in ("around", "card", "where"):
            r = subprocess.run([os.path.join(HERE, "mapview.py"), cmd] + argv[1:], capture_output=True, text=True, timeout=180)
            print((r.stdout + r.stderr).strip())
        elif cmd == "odds":
            xy = " ".join(argv[1:3]).replace(",", " ").split()
            a = {"x": int(xy[0]), "y": int(xy[1])}
            if len(argv) > 3:
                a["id"] = int(argv[3].lstrip("#"))
            r = call("odds", a)
            print("Attacks on %s (%s):" % (r["target"], r["note"]))
            for row in r["attacks"]:
                looks = row.get("defender_looks", {})
                print("  %s at %s, health %s: %s vs %s%s" % (
                    row["unit"], row["from"], row["my_health"], row.get("win_odds", "-"), row["defender"],
                    (" (health %s, strength %s%s%s)" % (looks.get("health"), looks.get("strength"),
                     ", " + ", ".join(looks["promotions"]) if looks.get("promotions") else "",
                     ", fortified" if looks.get("fortified") else "")) if looks else ""))
                for k in ("withdraw_chance", "collateral"):
                    if row.get(k):
                        print("      %s: %s" % (k.replace("_", " "), row[k]))
            if not r["attacks"]:
                print("  (no unit of ours in reach)")
        elif cmd == "tile":
            # "civ tile 56 16", "civ tile '56 16'" and "civ tile 56,16" all work
            xy = " ".join(argv[1:]).replace(",", " ").split()
            print(fmt_record(call("tile", {"x": int(xy[0]), "y": int(xy[1])})))
        elif cmd == "city":
            cmd_city(argv[1:])
        elif cmd == "unit":
            print(fmt_record(call("unit", {"id": int(argv[1])})))
        elif cmd == "player":
            cmd_player(argv[1:])
        elif cmd == "move":
            print(fmt_record(call("move", {"id": int(argv[1]), "x": int(argv[2]), "y": int(argv[3])})))
        elif cmd == "py":
            print(call("exec", {"code": " ".join(argv[1:]) if len(argv) > 1 else sys.stdin.read()})["value"])
        elif cmd == "ready":
            print(fmt_record(call("ready")))
        elif cmd == "actions":
            print(fmt_record(call("actions", {"id": int(argv[1])})))
        elif cmd == "do":
            words = [a for a in argv[1:] if not a.startswith("--")]
            args = {"id": int(words[0]), "action": words[1]}
            if len(words) > 3:
                args["x"], args["y"] = int(words[2]), int(words[3])
            elif len(words) == 3:
                args["unit"] = int(words[2].lstrip("#"))   # LEAD <unit id>
            if "--queue" in argv:
                args["queue"] = True
            print(fmt_record(call("do", args)))
        elif cmd in ("offer", "give"):
            give, get, i = [], [], 2
            if cmd == "give":
                give = argv[2:]
            else:
                side = None
                for a in argv[2:]:
                    if a in ("--give", "--get"):
                        side = give if a == "--give" else get
                    elif side is None:
                        raise SystemExit("offer: '%s' is neither after --give nor after --get" % a)
                    else:
                        side.extend(x.strip() for x in a.split(",") if x.strip())
            print(fmt_record(call("offer", {"player": argv[1], "give": give, "get": get})))
        elif cmd == "proposals":
            print(fmt_record(call("proposals", {})))
        elif cmd == "answer":
            if len(argv) < 3:
                raise SystemExit("civ answer N yes|no")
            print(fmt_record(call("answer", {"id": argv[1], "answer": argv[2]})))
        elif cmd == "victory":
            print(fmt_record(call("victory", {})))
        elif cmd == "relations":
            print(fmt_record(call("relations", {})))
        elif cmd == "tradeable":
            print(fmt_record(call("tradeable", {"player": argv[1]})))
        elif cmd == "rules":
            if len(argv) > 2 and argv[1] == "path":
                print(fmt_record(call("rules", {"name": " ".join(argv[2:]), "path": True})))
            else:
                print(fmt_record(call("rules", {"name": " ".join(argv[1:])})))
        elif cmd == "religion":
            print(fmt_record(call("religion", {"name": " ".join(argv[1:])} if len(argv) > 1 else {})))
        elif cmd == "civics":
            print(fmt_record(call("civics", {"names": argv[1:]} if len(argv) > 1 else {})))
        elif cmd == "offers":
            print(fmt_record(call("offers")))
        elif cmd == "war":
            r = call("war", {"player": argv[1], "check": "--check" in argv})
            if r.get("check"):
                print("Declaring war on %s now: %s" % (r["against"], "possible" if r["can_declare"] else "NOT possible (peace treaty or not met)"))
                print("Deals that end at once:" + "".join("\n  " + d for d in r["deals_that_end"]) if r["deals_that_end"] else "Deals that end at once: none")
                print("Our units in their land, pushed out to the nearest tile outside it at once:" +
                      "".join("\n  #%d %s (%d,%d)" % tuple(u) for u in r["our_units_pushed_out"]) if r["our_units_pushed_out"] else
                      "Our units in their land: none")
            else:
                print(fmt_record(r))
        elif cmd in ("ratify", "reject"):
            print(fmt_record(call(cmd, {"n": argv[1]})))
        elif cmd == "deals":
            print("\n".join(call("deals")["deals"]))
        elif cmd == "cancel":
            print(fmt_record(call("cancel", {"what": " ".join(argv[1:])})))
        elif cmd == "budget":
            print(fmt_record(call("budget", {"set": argv[1:]} if len(argv) > 1 else {})))
        elif cmd == "raze":
            print(fmt_record(call("raze", {"name": " ".join(argv[1:])})))
        elif cmd == "area":
            xy = " ".join(argv[1:]).replace(",", " ").split()
            args = {"x": int(xy[0]), "y": int(xy[1])}
            if len(xy) > 2:
                args["r"] = int(xy[2])
            r = call("area", args)
            print("\n".join(r["map"]))
            print("legend: " + r["legend"])
            for k in ("owners", "cities", "resources", "foreign_units", "best_city_sites"):
                if r.get(k):
                    print("%s: %s" % (k.replace("_", " "), "; ".join(r[k])))
        elif cmd == "research":
            words = [a for a in argv[1:] if not a.startswith("--")]
            args = {"tech": " ".join(words), "queue": "--queue" in argv} if words else {}
            print(fmt_record(call("research", args)))
        elif cmd == "build":
            words = [a for a in argv[1:] if not a.startswith("--")]
            args = {"name": words[0], "item": " ".join(words[1:])}
            for flag in ("queue", "first", "check"):
                if "--" + flag in argv:
                    args[flag] = True
            print(fmt_record(call("build", args)))
        elif cmd == "hurry":
            args = {"name": argv[1]}
            if len(argv) > 2:
                args["how"] = argv[2]
            print(fmt_record(call("hurry", args)))
        elif cmd == "hold":
            print(fmt_record(call("hold")))
        elif cmd == "gate":
            if len(argv) > 2 and argv[1] == "auto":
                args = {"auto": argv[2] == "on"}
                if len(argv) > 3:
                    args["every"] = int(argv[3])
            else:
                args = {"on": argv[1] == "on"} if len(argv) > 1 else {}
            print(fmt_record(call("gate", args)))
        elif cmd == "claim":
            print(fmt_record(call("claim", {"id": int(argv[1])})))
        elif cmd == "release":
            print(fmt_record(call("release", {"id": argv[1] if argv[1] == "all" else int(argv[1])})))
        elif cmd == "say":
            popup = len(argv) > 1 and argv[1] == "--popup"
            text = " ".join(argv[2 if popup else 1:])
            call("say", {"text": text, "popup": popup})
            # pair the message with the thought written just before it (playbook: think, then say)
            last = os.path.join(VIDEO_LOG_DIR, ".last_thought")
            tid = open(last).read().strip() if os.path.exists(last) else None
            if tid:
                os.remove(last)
            video_log("said.jsonl", {"text": text, "thought_id": tid})
            print("shown in game")
        elif cmd == "chat":
            n = int(argv[1]) if len(argv) > 1 else 20
            if os.path.exists(CHAT):
                sys.path.insert(0, HERE)
                import timeline
                for m in timeline.read(CHAT, timeline.chat_rewind)[-n:]:   # not the abandoned turns of a reload
                    print("T%-4d %s %-7s %s" % (m["turn"], m["time"], m["from"], m["text"]))
            else:
                print("no messages yet")
        elif cmd == "director":
            # a note to the CIVAI director (the human who maintains the tools), never seen in the game
            text = " ".join(argv[1:]).strip()
            path = os.path.join(VIDEO_LOG_DIR, "to_director.jsonl")
            if text:
                video_log("to_director.jsonl", {"text": text})
                print("sent to the director; answers come in director_notes.md")
            else:
                rows = [json.loads(l) for l in open(path)] if os.path.exists(path) else []
                print("\n".join("%s  %s" % (r["wall"], r["text"]) for r in rows[-10:]) or "(nothing sent yet)")
        elif cmd == "think":
            tid = uuid.uuid4().hex[:10]
            video_log("thoughts.jsonl", {"id": tid, "text": " ".join(argv[1:])})
            with open(os.path.join(VIDEO_LOG_DIR, ".last_thought"), "w") as f:
                f.write(tid)   # the next `civ say` is paired with this thought
            print("noted")
        elif cmd == "events":
            cmd_events(argv[1:])
        elif cmd == "raw":
            args = json.loads(argv[2]) if len(argv) > 2 else {}
            print(json.dumps(call(argv[1], args), indent=1, ensure_ascii=False))
        else:
            print("unknown command: %s\n\n%s" % (cmd, __doc__.strip()), file=sys.stderr)
            return 2
    except BridgeError as e:
        text = str(e)
        if os.environ.get("CIV_DEV") != "1":
            # the player gets the game's answer, not the bridge's Python traceback
            lines = [l.strip() for l in text.splitlines() if l.strip()]
            text = lines[-1] if lines else text
            for prefix in ("Exception: ", "ValueError: ", "KeyError: "):
                if text.startswith(prefix):
                    text = text[len(prefix):]
        print("ERROR: %s" % text, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
