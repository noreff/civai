{
  "agent": [
    "claude",
    "-p",
    "--strict-mcp-config",
    "--settings",
    "{\"disableAllHooks\": true}",
    "--tools",
    "Bash,Read,Write,Edit",
    "--disable-slash-commands",
    "--permission-mode",
    "bypassPermissions"
  ],
  "timeout_minutes": 15,
  "shadow": true,
  "prompt": "v1"
}
