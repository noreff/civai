-
-	if (isMPOption(MPOPTION_SIMULTANEOUS_TURNS))
-	{
-		shuffleArray(aiShuffle, MAX_PLAYERS, getSorenRand());
-
-		for (iI = 0; iI < MAX_PLAYERS; iI++)
-		{
