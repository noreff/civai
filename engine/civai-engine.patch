+int CvGame::calculateOptionsChecksum()
+{
+	PROFILE_FUNC();
+
+	int iValue;
+	int iI, iJ;
+
+	iValue = 0;
+
+	for (iI = 0; iI < MAX_PLAYERS; iI++)
+	{
+		for (iJ = 0; iJ < NUM_PLAYEROPTION_TYPES; iJ++)
+		{
+			if (GET_PLAYER((PlayerTypes)iI).isOption((PlayerOptionTypes)iJ))
+			{
+				iValue += (iI * 943097);
+				iValue += (iJ * 281541);
+			}
+		}
+	}
+
+	return iValue;
+}
