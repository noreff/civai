-	{
-		if(m_bIsBusyCache)
-		{
-			return false;
-		}
-	}
-	else
-	{
-		if (isBusy())
-		{
-			return false;
-		}
-	}
-
-	if(!canEverDoCommand(eCommand, iData1, iData2, bTestVisible, bUseCache))
-		return false;
