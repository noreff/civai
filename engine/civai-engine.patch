+// CIVAI: turns this group needs to reach (iX, iY) by the game's own pathfinder (-1: no path)
+int CySelectionGroup::claudePathTurns(int iX, int iY)
+{
+	if (!m_pSelectionGroup)
+		return -1;
+	CvPlot* pTo = GC.getMapINLINE().plot(iX, iY);
+	int iTurns = -1;
+	if (pTo == NULL || !m_pSelectionGroup->generatePath(m_pSelectionGroup->plot(), pTo, 0, false, &iTurns))
+		return -1;
+	return iTurns;
+}
