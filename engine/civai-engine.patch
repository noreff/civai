+// CIVAI: a game of several agents plays like a simultaneous-turns multiplayer game: every civ's turn is
+// active at once, so each agent's orders run when it gives them (no waiting for the civs before it)
+void CyGame::claudeSetSimultaneousTurns(bool bOn)
+{
+	if (m_pGame)
+		m_pGame->setMPOption(MPOPTION_SIMULTANEOUS_TURNS, bOn);
+}
+
+bool CyGame::claudeSimultaneousTurns()
+{
+	return m_pGame ? m_pGame->isMPOption(MPOPTION_SIMULTANEOUS_TURNS) : false;
+}
