+void CyPlayer::handleDiploEvent(int /*DiploEventTypes*/ eDiploEvent, int /*PlayerTypes*/ ePlayer, int iData1, int iData2)
+{
+	// CIVAI: Claude's answer to this AI's request, with the same effects as a human's answer on the screen
+	if (m_pPlayer)
+		m_pPlayer->handleDiploEvent((DiploEventTypes)eDiploEvent, (PlayerTypes)ePlayer, iData1, iData2);
+}
+
+// CIVAI: deals in text form, "item:data,item:data" (TradeableItems numbers), judged and run by the game's own code
+static void claudeParseTrades(const std::string& szText, CLinkList<TradeData>& list)
+{
+	const char* p = szText.c_str();
+	while (*p)
+	{
+		int iItem, iData, n = 0;
+		if (sscanf(p, "%d:%d%n", &iItem, &iData, &n) != 2)
+		{
+			break;
+		}
+		TradeData item;
+		setTradeItem(&item, (TradeableItems)iItem, iData);
+		list.insertAtEnd(item);
+		p += n;
+		if (*p == ',')
+		{
+			p++;
+		}
+	}
+}
+
+// this AI's answer to ePlayer offering szTheirs for szOurs (the game's CvPlayerAI::AI_considerOffer)
+bool CyPlayer::AI_considerOfferText(int /*PlayerTypes*/ ePlayer, std::string szTheirs, std::string szOurs)
+{
+	if (!m_pPlayer)
+		return false;
+	CLinkList<TradeData> theirList;
+	CLinkList<TradeData> ourList;
+	claudeParseTrades(szTheirs, theirList);
+	claudeParseTrades(szOurs, ourList);
+	return m_pPlayer->AI_considerOffer((PlayerTypes)ePlayer, &theirList, &ourList);
+}
+
+// the deal "we give szOurs, eOther gives szTheirs", made by the game's CvGame::implementDeal (items checked)
+bool CyPlayer::implementDealText(int /*PlayerTypes*/ eOther, std::string szOurs, std::string szTheirs)
+{
+	if (!m_pPlayer)
+		return false;
+	CLinkList<TradeData> ourList;
+	CLinkList<TradeData> theirList;
+	claudeParseTrades(szOurs, ourList);
+	claudeParseTrades(szTheirs, theirList);
+	if (ourList.getLength() == 0 && theirList.getLength() == 0)
+		return false;
+	GC.getGameINLINE().implementDeal(m_pPlayer->getID(), (PlayerTypes)eOther, &ourList, &theirList);
+	return true;
+}
+
+bool CyPlayer::claudeApplyEvent(int /*EventTypes*/ eEvent, int iTriggeredId)
+{
