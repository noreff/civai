+EraTypes CvGame::getCurrentEra() const
+{
+	int iEra;
+	int iCount;
+	int iI;
+
+	iEra = 0;
+	iCount = 0;
+
+	for (iI = 0; iI < MAX_PLAYERS; iI++)
+	{
+		if (GET_PLAYER((PlayerTypes)iI).isAlive())
+		{
+			iEra += GET_PLAYER((PlayerTypes)iI).getCurrentEra();
+			iCount++;
+		}
+	}
+
+	if (iCount > 0)
+	{
+		return ((EraTypes)(iEra / iCount));
+	}
+
+	return NO_ERA;
+}
