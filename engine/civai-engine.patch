+	{
+		m_eAutomateType = eNewValue;
+
+		clearMissionQueue();
+		setActivityType(ACTIVITY_AWAKE);
+
+		// if canceling automation, cancel on cargo as well
+		if (eNewValue == NO_AUTOMATE)
