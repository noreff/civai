+					if (NULL != pInfo)
+					{
+						GET_PLAYER((PlayerTypes)iI).addPopup(pInfo);
+					}
+				}
+			}
+		}
+
+		gDLL->getInterfaceIFace()->setDirty(Cursor_DIRTY_BIT, true);
