+
+void CyPlayer::handleDiploEvent(int /*DiploEventTypes*/ eDiploEvent, int /*PlayerTypes*/ ePlayer, int iData1, int iData2)
+{
+	// CIVAI: Claude's answer to this AI's request, with the same effects as a human's answer on the screen.
+	// Only the answers to an AI's requests, only from Claude, and only what the game still allows.
+	if (!m_pPlayer || ePlayer < 0 || ePlayer >= MAX_CIV_PLAYERS || !GET_PLAYER((PlayerTypes)ePlayer).isClaude() || m_pPlayer->isHuman())
+		return;
+	CvPlayer& kClaude = GET_PLAYER((PlayerTypes)ePlayer);
+	switch ((DiploEventTypes)eDiploEvent)
+	{
+	case DIPLOEVENT_GIVE_HELP: case DIPLOEVENT_REFUSED_HELP: case DIPLOEVENT_ACCEPT_DEMAND: case DIPLOEVENT_REJECTED_DEMAND:
+	case DIPLOEVENT_NO_CONVERT: case DIPLOEVENT_NO_REVOLUTION: case DIPLOEVENT_NO_JOIN_WAR: case DIPLOEVENT_NO_STOP_TRADING:
+		break;
+	case DIPLOEVENT_DEMAND_WAR:
+		if (!GET_TEAM(m_pPlayer->getTeam()).canDeclareWar(kClaude.getTeam()))
+			return;
+		break;
+	case DIPLOEVENT_CONVERT:
+		if (m_pPlayer->getStateReligion() == NO_RELIGION || !kClaude.canConvert(m_pPlayer->getStateReligion()))
+			return;
+		break;
+	case DIPLOEVENT_REVOLUTION:
+		{
+			CivicTypes eFav = (CivicTypes)GC.getLeaderHeadInfo(m_pPlayer->getPersonalityType()).getFavoriteCivic();
+			if (eFav == NO_CIVIC || !kClaude.canDoCivics(eFav) || !kClaude.canRevolution(NULL))
+				return;
+		}
+		break;
+	case DIPLOEVENT_JOIN_WAR:
+		if (iData1 < 0 || iData1 >= MAX_CIV_TEAMS || !GET_TEAM(kClaude.getTeam()).canDeclareWar((TeamTypes)iData1))
+			return;
+		break;
+	case DIPLOEVENT_STOP_TRADING:
+		if (iData1 < 0 || iData1 >= MAX_CIV_TEAMS)
+			return;
+		break;
+	default:
+		return;
+	}
+	m_pPlayer->handleDiploEvent((DiploEventTypes)eDiploEvent, (PlayerTypes)ePlayer, iData1, iData2);
+}
+
+// CIVAI: deals in text form, "item:data,item:data" (TradeableItems numbers), judged and run by the game's own code
+static void claudeParseTrades(const std::string& szText, CLinkList<TradeData>& list)
+{
+	const char* p = szText.c_str();
+	while (*p)
+	{
+		int iItem, iData, n = 0;
+		if (sscanf(p, "%d:%d%n", &iItem, &iData, &n) != 2)
+		{
+			break;
+		}
+		if (iItem < 0 || iItem >= NUM_TRADEABLE_ITEMS || ((iItem == TRADE_GOLD || iItem == TRADE_GOLD_PER_TURN) && iData < 0))
+		{
+			list.clear();	// a bad item spoils the whole deal: nothing is traded
+			return;
+		}
+		TradeData item;
+		setTradeItem(&item, (TradeableItems)iItem, iData);
+		list.insertAtEnd(item);
+		p += n;
+		if (*p == ',')
+		{
+			p++;
+		}
+	}
+}
+
+// this AI's answer to ePlayer offering szTheirs for szOurs (the game's CvPlayerAI::AI_considerOffer)
+bool CyPlayer::AI_considerOfferText(int /*PlayerTypes*/ ePlayer, std::string szTheirs, std::string szOurs)
+{
+	if (!m_pPlayer)
+		return false;
+	CLinkList<TradeData> theirList;
+	CLinkList<TradeData> ourList;
+	claudeParseTrades(szTheirs, theirList);
+	claudeParseTrades(szOurs, ourList);
+	return m_pPlayer->AI_considerOffer((PlayerTypes)ePlayer, &theirList, &ourList);
+}
+
+// the deal "we give szOurs, eOther gives szTheirs", made by the game's CvGame::implementDeal (items checked)
+bool CyPlayer::implementDealText(int /*PlayerTypes*/ eOther, std::string szOurs, std::string szTheirs)
+{
+	if (!m_pPlayer)
+		return false;
+	CLinkList<TradeData> ourList;
+	CLinkList<TradeData> theirList;
+	claudeParseTrades(szOurs, ourList);
+	claudeParseTrades(szTheirs, theirList);
+	if (ourList.getLength() == 0 && theirList.getLength() == 0)
+		return false;
+	if (eOther < 0 || eOther >= MAX_CIV_PLAYERS || eOther == m_pPlayer->getID())
+		return false;
+	// every item must be one the game allows now (as on the trade screen)
+	for (CLLNode<TradeData>* pNode = ourList.head(); pNode; pNode = ourList.next(pNode))
+	{
+		if (!m_pPlayer->canTradeItem((PlayerTypes)eOther, pNode->m_data, false))
+			return false;
+	}
+	for (CLLNode<TradeData>* pNode = theirList.head(); pNode; pNode = theirList.next(pNode))
+	{
+		if (!GET_PLAYER((PlayerTypes)eOther).canTradeItem(m_pPlayer->getID(), pNode->m_data, false))
+			return false;
+	}
+	GC.getGameINLINE().implementDeal(m_pPlayer->getID(), (PlayerTypes)eOther, &ourList, &theirList);
+	return true;
+}
+
+bool CyPlayer::claudeApplyEvent(int /*EventTypes*/ eEvent, int iTriggeredId)
+{
+	return m_pPlayer ? m_pPlayer->claudeApplyEvent((EventTypes)eEvent, iTriggeredId) : false;
+}
