+	iLength = GC.getDefineINT("GOLDEN_AGE_LENGTH");
+
+	iLength *= GC.getGameSpeedInfo(getGameSpeedType()).getGoldenAgePercent();
+	iLength /= 100;
+
+	return iLength;
+}
