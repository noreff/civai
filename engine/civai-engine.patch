-				}
-			}
-		}
-		else
-		{
-			aaiDistances[iI] = NULL;
-		}
-	}
-
-	for (iI = 0; iI < MAX_CIV_PLAYERS; iI++)
-	{
-		aiStartingLocs[iI] = iI; // each player starting in own location
-	}
-
-	int iBestScore = getTeamClosenessScore(aaiDistances, aiStartingLocs);
-	bool bFoundSwap = true;
-	while (bFoundSwap)
-	{
-		bFoundSwap = false;
-		for (iI = 0; iI < MAX_CIV_PLAYERS; iI++)
