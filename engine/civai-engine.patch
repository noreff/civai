+// CIVAI: a trade list as text for the bridge, "item:data,item:data" (TradeableItems numbers)
+static CvString claudeTradeText(const CLinkList<TradeData>* pList)
+{
+	CvString s;
+	if (pList != NULL)
+	{
+		for (CLLNode<TradeData>* pNode = pList->head(); pNode; pNode = pList->next(pNode))
+		{
+			CvString item;
+			item.Format("%d:%d", (int)pNode->m_data.m_eItemType, pNode->m_data.m_iData);
+			if (!s.empty())
+			{
+				s += ",";
+			}
+			s += item;
+		}
+	}
+	return s;
+}
