+	}
+
+		m_aiCloseBordersAttitudeCache[ePlayer] = ((GC.getLeaderHeadInfo(getPersonalityType()).getCloseBordersAttitudeChange() * iPercent) / 100);
+	}
+
+	return m_aiCloseBordersAttitudeCache[ePlayer];
