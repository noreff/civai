+// CIVAI: Claude's vote in a UN / Apostolic Palace vote he was asked about (game event "claudeVote")
+void CyGame::castVote(int /*PlayerTypes*/ eOwnerIndex, int iVoteId, int /*PlayerVoteTypes*/ ePlayerVote)
+{
+	if (m_pGame && GET_PLAYER((PlayerTypes)eOwnerIndex).isClaude() && m_pGame->getVoteTriggered(iVoteId) != NULL)
+	{
+		m_pGame->castVote((PlayerTypes)eOwnerIndex, iVoteId, (PlayerVoteTypes)ePlayerVote);
+	}
+}
