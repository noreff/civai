+bool CvSelectionGroup::groupBuild(BuildTypes eBuild)
+{
+	CLLNode<IDInfo>* pUnitNode;
+	CvUnit* pLoopUnit;
+	CvPlot* pPlot;
+	bool bContinue;
+
+	FAssert(getOwnerINLINE() != NO_PLAYER);
