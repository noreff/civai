+void CvPlayerAI::AI_chooseFreeTech()
+{
+	TechTypes eBestTech;
+
+	if (isClaude())
+	{
+		// CIVAI: a free tech (Oracle, first to a tech...) is Claude's pick: the bridge keeps it for him
+		CyArgsList args;
+		args.add((int)getID());
+		CvEventReporter::getInstance().genericEvent("claudeFreeTech", args.makeFunctionArgs());
+		return;
+	}
+
+	clearResearchQueue();
+
+	CyArgsList argsList;
+	long lResult;
+	argsList.add(getID());
+	argsList.add(true);
+	lResult = -1;
+	gDLL->getPythonIFace()->callFunction(PYGameModule, "AI_chooseTech", argsList.makeFunctionArgs(), &lResult);
+	eBestTech = ((TechTypes)lResult);
+
+	if (eBestTech == NO_TECH)
+	{
+		eBestTech = AI_bestTech(1, true);
+	}
+
+	if (eBestTech != NO_TECH)
+	{
+		GET_TEAM(getTeam()).setHasTech(eBestTech, true, getID(), true, true);
+	}
+}
