-#ifndef PITBOSS
-
-	CvUnit *pHeadUnit;
-	int iScriptId = -1;
-
-	pHeadUnit = getHeadUnit();
-	if ( pHeadUnit )
-	{
-		iScriptId = pHeadUnit->getArtInfo(0, GET_PLAYER(getOwnerINLINE()).getCurrentEra())->getActionSoundScriptId();
-	}
-
-	if ( (iScriptId == -1) && pHeadUnit )
