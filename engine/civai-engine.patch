+void CvPlayer::setClaude(bool bNewValue)
+{
+	if (bNewValue && !m_bClaude)
+	{
+		// CIVAI: war plans the built-in AI made while it ran this civ would let automated units
+		// start wars; only real wars keep a plan
+		for (int iI = 0; iI < MAX_CIV_TEAMS; iI++)
+		{
+			if (iI != getTeam() && GET_TEAM((TeamTypes)iI).isAlive() && !GET_TEAM(getTeam()).isAtWar((TeamTypes)iI))
+			{
+				GET_TEAM(getTeam()).AI_setWarPlan((TeamTypes)iI, NO_WARPLAN);
+			}
+		}
+	}
+	m_bClaude = bNewValue;
+}
+
+// CIVAI: Claude's choice in a random event or quest (as a human picks in the event popup)
+bool CvPlayer::claudeApplyEvent(EventTypes eEvent, int iTriggeredId)
+{
+	EventTriggeredData* pData = getEventTriggered(iTriggeredId);
+	if (pData == NULL || eEvent == NO_EVENT || !canDoEvent(eEvent, *pData))
+	{
+		return false;
+	}
+	applyEvent(eEvent, iTriggeredId);
+	return true;
+}
