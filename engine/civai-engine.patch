+		kExtraYield.m_iY = iY;
+		for (int i = 0; i < NUM_YIELD_TYPES; ++i)
+		{
+			if (eYield == i)
+			{
+				kExtraYield.m_aeExtraYield.push_back(iExtraYield);
+			}
+			else
+			{
+				kExtraYield.m_aeExtraYield.push_back(0);
+			}
+		}
+		m_aPlotExtraYields.push_back(kExtraYield);
+	}
+
+	CvPlot* pPlot = GC.getMapINLINE().plot(iX, iY);
