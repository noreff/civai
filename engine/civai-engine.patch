-void CvGame::normalizeStartingPlotLocations()
-{
-	CvPlot* apNewStartPlots[MAX_CIV_PLAYERS];
-	int* aaiDistances[MAX_CIV_PLAYERS];
-	int aiStartingLocs[MAX_CIV_PLAYERS];
