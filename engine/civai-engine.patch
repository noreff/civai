-	int* piShuffle = new int[iNum];
-	shuffleArray(piShuffle, iNum, rand);
-	return piShuffle;
-}
-
-
-void shuffleArray(int* piShuffle, int iNum, CvRandom& rand)
-{
-	int iI, iJ;
-
-	for (iI = 0; iI < iNum; iI++)
-	{
-		piShuffle[iI] = iI;
-	}
-
-	for (iI = 0; iI < iNum; iI++)
-	{
-		iJ = (rand.get(iNum - iI, NULL) + iI);
-
-		if (iI != iJ)
-		{
-			int iTemp = piShuffle[iI];
-			piShuffle[iI] = piShuffle[iJ];
-			piShuffle[iJ] = iTemp;
-		}
-	}
-}
