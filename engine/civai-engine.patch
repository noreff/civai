-			if (GET_PLAYER((PlayerTypes)iLoopPlayer).isAlive())
-			{
-				GET_PLAYER((PlayerTypes)iLoopPlayer).setTurnActive(true);
-			}
-		}
-	}
-	else if (isSimultaneousTeamTurns())
-	{
-		for (iI = 0; iI < MAX_TEAMS; iI++)
-		{
-			CvTeam& kTeam = GET_TEAM((TeamTypes)iI);
-			if (kTeam.isAlive())
