+// CIVAI: the AI opens the diplomacy screen with a player. Claude has no screen: his proposals,
+// demands and requests go to the bridge as the game event "claudeDiplomacy" and he answers there.
+void CvPlayerAI::AI_beginDiplomacy(CvDiploParameters* pDiplo, PlayerTypes ePlayer)
+{
+	if (GET_PLAYER(ePlayer).isClaude())
+	{
+		// the screen's "our" list is what the receiver (Claude) gives, "their" list what this AI gives
+		CvString szGives = claudeTradeText(&(pDiplo->getTheirOfferList()));
+		CvString szWants = claudeTradeText(&(pDiplo->getOurOfferList()));
+		CyArgsList args;
+		args.add((int)getID());
+		args.add((int)ePlayer);
+		args.add((int)pDiplo->getDiploComment());
+		args.add(pDiplo->getData());
+		args.add(szGives.c_str());
+		args.add(szWants.c_str());
+		CvEventReporter::getInstance().genericEvent("claudeDiplomacy", args.makeFunctionArgs());
+		SAFE_DELETE(pDiplo);
+		return;
+	}
+	gDLL->beginDiplomacy(pDiplo, ePlayer);
+}
