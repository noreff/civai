+// CIVAI: the agent Resident picks a resolution; a pick out of range (-1) takes the one the game's AI would choose
+bool CyGame::claudeChooseElection(int iVoteSelectionId, int iSelection)
+{
+	if (!m_pGame)
+		return false;
+	VoteSelectionData* pData = m_pGame->getVoteSelection(iVoteSelectionId);
+	if (pData == NULL)
+		return false;
+	if (iSelection < 0 || iSelection >= (int)pData->aVoteOptions.size())
+	{
+		TeamTypes eSecretary = m_pGame->getSecretaryGeneral(pData->eVoteSource);
+		if (eSecretary == NO_TEAM)
+			return false;
+		iSelection = GET_TEAM(eSecretary).AI_chooseElection(*pData);
+	}
+	m_pGame->setVoteChosen(iSelection, iVoteSelectionId);
+	return true;
+}
