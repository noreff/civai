+	BuildTypes eBestBuild;
+
+	if (!AI_isControlled() || !at(iX, iY) || (getLengthMissionQueue() == 1))
+	{
+		pPlot = plot();
+
+		eBestRoute = getBestBuildRoute(pPlot, &eBestBuild);
+
+		if (eBestBuild != NO_BUILD)
+		{
+			groupBuild(eBestBuild);
+			return true;
+		}
+	}
+
+	return groupPathTo(iX, iY, iFlags);
